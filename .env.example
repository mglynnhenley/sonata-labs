# Sonata Labs — every variable the code actually reads.
#
# `.env` is gitignored; this file is the only list, and it is audited against the
# source rather than remembered.
#
#   npx sonata init      writes .env, asks for the one variable that is required
#   cp .env.example .env then replace the OPENROUTER_API_KEY placeholder below —
#                        `sonata doctor` reports the placeholder as no key
#
# Who reads it: the Next dev servers read `.env` themselves. `npm run sonata`
# reads apps/platform/.env, then this file's directory, then apps/gmail/.env, in
# that order; the Gmail clone's own CLIs read the .env beside them. None of them
# overwrites a variable the shell already set, so `OPENROUTER_MODEL=… npm run
# sonata …` always wins over the file.
#
# Everything below except OPENROUTER_API_KEY has a working default. You should
# need none of them to run the product on one machine.


# ---------------------------------------------------------------------------
# The model
# ---------------------------------------------------------------------------

# REQUIRED for anything that costs money: cloning a business, running a day,
# judging a run. Get one at https://openrouter.ai/keys
#
# THE TRAP: the name is OPENROUTER_API_KEY. OPEN_ROUTER_KEY is silently ignored —
# no warning, no error at the door; the run starts, the world seeds, and then
# every director tick fails with "OPENROUTER_API_KEY is not set". That has cost
# an afternoon already. Check the spelling before you check anything else.
#
# The dashboard has a second, higher-priority source: a key typed into Settings
# lives in platform.db and wins over this one. `npm run sonata -- status` prints
# which of the two it found.
OPENROUTER_API_KEY=sk-or-v1-...

# Default model for every role that does not name its own (agent, director,
# world generator, judge). Slugs use dots, not dashes.
# Defaults: anthropic/claude-haiku-4.5 for the engine and the dashboard,
# anthropic/claude-opus-4.8 for world generation and the Gmail eval CLI.
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Point every model call somewhere else — a proxy, a recorder, a local gateway.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ceiling on reasoning effort: low | medium | high | none. High effort is most of
# the wall clock on a run, so a smoke pass caps it here instead of editing call
# sites; `none` drops reasoning entirely. A typo is ignored, not fatal.
# SONATA_MAX_EFFORT=low
# EVAL_MAX_EFFORT=low          # the same cap, for the Gmail eval CLI only


# ---------------------------------------------------------------------------
# The clones
# ---------------------------------------------------------------------------

# The port one clone binds. It is per-app, not global: `npm run dev:gmail` and
# friends set 3101 / 3200 / 3400 for you, so set this only when running a clone
# by hand, or when something else already owns the port.
# PORT=3101

# Four more clones ship as plain API surfaces — no UI, and not yet wired into an
# episode as twins. Each has its own `npm run dev:<name>` and its own port:
# attio 3500, google-docs 3600, google-ads 3700, linkedin 3800.

# The bearer token all three clones accept. A seatbelt, not a lock — it exists so
# an agent cannot reach the clones by accident, and it is the same value the MCP
# server and every smoke script default to.
# SANDBOX_TOKEN=sandbox-token

# How Gmail's /gmail/v1/* is gated. `token` (the default): SANDBOX_TOKEN works
# there with full scope — zero setup. `oauth`: only tokens from the clone's own
# OAuth2 server are accepted, per-route scopes enforced, and the UI runs the full
# consent flow. The OAuth endpoints are mounted in both modes.
# SANDBOX_AUTH=token

# Where the smoke, demo and reset scripts point. Defaults to localhost on $PORT.
# SANDBOX_ROOT_URL=http://localhost:3101

# Slack only. The base URL written into file links the clone hands back, and the
# secret it signs outgoing events with (a real Slack app would verify this).
# SANDBOX_PUBLIC_URL=http://localhost:3200
# SANDBOX_SIGNING_SECRET=sandbox-signing-secret

# The port `npm run smoke -w apps/slack`'s event receiver listens on.
# SMOKE_EVENT_PORT=4399


# ---------------------------------------------------------------------------
# Where the clones live
# ---------------------------------------------------------------------------

# Two sets of names for the same three URLs, because two callers ask: the engine's
# adapters read *_TWIN_URL, the dashboard and the MCP server read SONATA_*_URL.
# Change one set and the other still points at the defaults, so if you move a
# clone off its default port, set both.
# GMAIL_TWIN_URL=http://localhost:3101
# SLACK_TWIN_URL=http://localhost:3200
# CALENDAR_TWIN_URL=http://localhost:3400
# SONATA_GMAIL_URL=http://localhost:3101
# SONATA_SLACK_URL=http://localhost:3200
# SONATA_CALENDAR_URL=http://localhost:3400

# The token the MCP server sends. Falls back to SANDBOX_TOKEN, so a shell already
# set up to curl the clones needs no second variable.
# SONATA_TOKEN=sandbox-token


# ---------------------------------------------------------------------------
# Where state is kept
# ---------------------------------------------------------------------------

# All three default to apps/platform/data/… and are gitignored. Point them
# elsewhere to keep two sets of runs apart, or to run the CLI against a scratch
# database. The clones' own SQLite files are not configurable: they live in
# apps/<clone>/data and a reset is a file copy, which is what makes two runs of
# the same day comparable.
# SONATA_PLATFORM_DB=apps/platform/data/platform.db
# SONATA_RUNS_DIR=apps/platform/data/runs
# SONATA_BENCH_DIR=apps/platform/data/benchmarks


# ---------------------------------------------------------------------------
# Cloning from a real account (optional, read-only)
# ---------------------------------------------------------------------------

# Only for `npm run sync` in apps/gmail and apps/slack, which pull a real mailbox
# or workspace into a local snapshot. Read-only scopes; nothing is ever written
# back. Neither is needed to use Sonata — a generated or template business needs
# no real account at all.
# GOOGLE_CREDENTIALS_PATH=apps/gmail/data/credentials.json
# SLACK_TOKEN=xoxp-...


# ---------------------------------------------------------------------------
# The Gmail OAuth UI (apps/gmail-ui)
# ---------------------------------------------------------------------------

# The separate front end that talks to the Gmail clone as a real third-party
# OAuth client. The defaults match the dev client the clone seeds at db:init, so
# the bundled experience needs none of this set. Change the secrets if you ever
# expose it beyond localhost — and note NODE_ENV=production is what turns on
# secure cookies.
# GMAIL_API_URL=http://localhost:3101
# GMAIL_UI_CLIENT_ID=sonata-gmail-ui
# GMAIL_UI_CLIENT_SECRET=dev-ui-secret-not-for-production
# GMAIL_UI_REDIRECT_URI=http://localhost:3901/oauth/callback
# GMAIL_UI_COOKIE_SECRET=dev-cookie-secret-change-me-please
