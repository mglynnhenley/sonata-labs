{
  "name": "sonata-labs",
  "version": "0.1.0",
  "description": "Clone your business into a fake Gmail, Slack and Calendar, run your agent through a simulated workday inside it, and score how much of the job it finished.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n platform,gmail-api,gmail-ui,slack,calendar -c magenta,red,yellow,green,blue \"npm:dev:platform\" \"npm:dev:gmail:api\" \"npm:dev:gmail:ui\" \"npm:dev:slack\" \"npm:dev:calendar\"",
    "dev:platform": "npm run dev -w apps/platform",
    "dev:gmail": "concurrently -n api,ui -c red,yellow \"npm:dev:gmail:api\" \"npm:dev:gmail:ui\"",
    "dev:gmail:api": "PORT=${PORT:-3101} npm run dev -w apps/gmail",
    "dev:gmail:ui": "PORT=${PORT:-3901} npm run dev -w apps/gmail-ui",
    "dev:slack": "PORT=${PORT:-3200} npm run dev -w apps/slack",
    "dev:calendar": "PORT=${PORT:-3400} npm run dev -w apps/calendar",
    "sonata": "node packages/cli/bin/sonata.mjs",
    "world": "cd apps/platform && tsx src/cli/sonata.ts world",
    "episode": "cd apps/platform && tsx src/cli/sonata.ts run",
    "judge": "cd apps/platform && tsx src/cli/sonata.ts judge",
    "bench": "cd apps/platform && tsx src/cli/sonata.ts bench",
    "test": "npm run test --workspaces --if-present",
    "test:gmail": "npm run test -w apps/gmail",
    "test:slack": "npm run test -w apps/slack",
    "test:calendar": "npm run test -w apps/calendar",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:twin": "tsx packages/engine/scripts/twin-contract-check.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
