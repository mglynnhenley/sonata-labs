{
  "name": "@sonata/scenarios",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The five hand-written episodes: one simulated workday each, none of them solvable from a single message.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sonata/core": "*"
  },
  "devDependencies": {
    "@sonata/judge": "*",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
