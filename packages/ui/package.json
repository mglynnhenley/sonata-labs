{
  "name": "@sonata/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sonata Labs design system — cream, serif-italic, Stripe-grade.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens": "./src/tokens.ts",
    "./fonts": "./src/fonts.ts"
  },
