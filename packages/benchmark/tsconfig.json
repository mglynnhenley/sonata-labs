{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    // Resolve workspace siblings by path as well as by name: a typecheck that
    // only passes after `npm install` has linked node_modules/@sonata is a
    // typecheck nobody runs. Only the packages this one imports are listed —
    // @sonata/engine is a dependency but is reached through an injected port
    // (see src/run.ts), never imported, so it needs no path.
    "baseUrl": ".",
    "paths": {
      "@sonata/core": ["../core/src/index.ts"],
      "@sonata/core/*": ["../core/src/*.ts"],
      "@sonata/judge": ["../judge/src/index.ts"],
      "@sonata/judge/*": ["../judge/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
